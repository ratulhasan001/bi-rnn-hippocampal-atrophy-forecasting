        <mxCell id="notation" parent="1" style="text;html=1;align=left;strokeColor=#AAAAAA;fillColor=#FEFEFE;rounded=1;arcSize=5;strokeWidth=1;fontSize=15;" value="&lt;table style=&quot;border-collapse: collapse; font-family: Helvetica;&quot;&gt;&lt;tbody&gt;&lt;tr style=&quot;background:#E8E8E8;&quot;&gt;&lt;th style=&quot;padding:4px 10px;border:1px solid #AAAAAA;&quot;&gt;Symbol&lt;/th&gt;&lt;th style=&quot;padding:4px 10px;border:1px solid #AAAAAA;&quot;&gt;Description&lt;/th&gt;&lt;th style=&quot;padding:4px 10px;border:1px solid #AAAAAA;&quot;&gt;Symbol&lt;/th&gt;&lt;th style=&quot;padding:4px 10px;border:1px solid #AAAAAA;&quot;&gt;Description&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 10px;border:1px solid #CCCCCC;&quot;&gt;\(R\)&lt;/td&gt;&lt;td style=&quot;padding:3px 10px;border:1px solid #CCCCCC;&quot;&gt;data_range = v_max − v_min&lt;/td&gt;&lt;td style=&quot;padding:3px 10px;border:1px solid #CCCCCC;&quot;&gt;\(\tau\)&lt;/td&gt;&lt;td style=&quot;padding:3px 10px;border:1px solid #CCCCCC;&quot;&gt;growth tolerance (default 0.01 = 1%)&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#F8F8F8;&quot;&gt;&lt;td style=&quot;padding:3px 10px;border:1px solid #CCCCCC;&quot;&gt;\(v_{\min}\)&lt;/td&gt;&lt;td style=&quot;padding:3px 10px;border:1px solid #CCCCCC;&quot;&gt;data_min (MinMax scaler)&lt;/td&gt;&lt;td style=&quot;padding:3px 10px;border:1px solid #CCCCCC;&quot;&gt;\(\lambda_{\text{bio}}\)&lt;/td&gt;&lt;td style=&quot;padding:3px 10px;border:1px solid #CCCCCC;&quot;&gt;biological plausibility penalty weight&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:3px 10px;border:1px solid #CCCCCC;&quot;&gt;\(\hat{v},\, v_{\text{last}}\)&lt;/td&gt;&lt;td style=&quot;padding:3px 10px;border:1px solid #CCCCCC;&quot;&gt;unscaled hippocampal volumes (mm³)&lt;/td&gt;&lt;td style=&quot;padding:3px 10px;border:1px solid #CCCCCC;&quot;&gt;\(\lambda_{\text{traj}}\)&lt;/td&gt;&lt;td style=&quot;padding:3px 10px;border:1px solid #CCCCCC;&quot